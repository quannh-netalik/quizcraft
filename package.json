{
  "name": "quizcraft",
  "version": "0.1.1",
  "description": "Interactive quiz, code, slide and calculator widgets from Obsidian callouts.",
  "main": "main.js",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "quiz",
    "flashcards",
    "learning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3"
  }
}
