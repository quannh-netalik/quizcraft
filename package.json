{
  "name": "quizcraft",
  "version": "1.1.0",
  "description": "Interactive quiz, code, slide and calculator widgets from Obsidian callouts.",
  "main": "main.js",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun build.ts",
    "build": "bun run typecheck && bun build.ts --production",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "bump": "bun scripts/version-bump.ts",
    "check:styles": "bun scripts/check-styles.ts"
  },
  "keywords": [
    "obsidian",
    "quiz",
    "flashcards",
    "learning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.13.1",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
